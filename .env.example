# Copy this file to ".env" and fill in real values for your environment.
# Never commit the actual ".env" file to version control.

# PostgreSQL connection string (used by Prisma Client and migrations)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/luxdues?sslmode=disable"

# Secret used to sign JWT auth tokens. Generate a long random string for production.
JWT_SECRET="change-this-to-a-long-random-secret"
